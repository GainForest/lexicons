{
  "lexicon": 1,
  "id": "app.gainforest.organization.media.image",
  "defs": {
    "main": {
      "type": "record",
      "description": "A declaration of a image media for an organization",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["image", "createdAt"],
        "properties": {
          "image": {
            "type": "ref",
            "ref": "app.gainforest.common.defs#smallImage",
            "description": "An image uploaded as blob"
          },
          "caption": {
            "type": "string",
            "description": "A caption for the image"
          },
          "createdAt": {
            "type": "string",
            "description": "The date and time of the creation of the record",
            "format": "datetime"
          }
        }
      }
    }
  }
}
