{
  "lexicon": 1,
  "id": "app.gainforest.organization.insights.insect",
  "defs": {
    "source": {
      "type": "object",
      "required": ["insect"],
      "properties": {
        "name": {
          "type": "string",
          "description": "A title for the source of the insect analysis"
        },
        "value": {
          "type": "union",
          "refs": [
            "app.gainforest.common.defs#uri",
            "app.gainforest.common.defs#smallBlob"
          ],
          "description": "A URI or blob pointing to the source of the insect analysis"
        }
      }
    },
    "main": {
      "type": "record",
      "description": "A declaration of a insect insights for an organization",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["soundscape", "createdAt"],
        "properties": {
          "insightSource": {
            "type": "ref",
            "ref": "#source",
            "description": "A reference to the source of the insect analysis"
          },
          "createdAt": {
            "type": "string",
            "description": "The date and time of the creation of the record",
            "format": "datetime"
          }
        }
      }
    }
  }
}
